+    notice=page.get_by_role('heading', name='We suspect automated behavior on your account', exact=True)
+    outcomes=inbox.or_(login).or_(saved).or_(notice)
+    for _ in range(3):
+        await expect(outcomes).not_to_have_count(0, timeout=60_000)
